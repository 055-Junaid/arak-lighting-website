# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the record of which variables the build expects is worth committing.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code worktrees / session scratch
.claude/

# netlify local state. The Next.js runtime (the OpenNext Netlify adapter) is
# installed by Netlify at build time, so nothing of it is committed here.
.netlify/
.dev.vars


# local pre-optimisation image backups
/_originals/

# The full candidate set from the fal.ai run. Nothing serves these, so they
# stay local. /public/generated/ holds the frames actually chosen for use and
# IS committed: src/lib/service-details.ts references them, so leaving them out
# ships eight service pages with broken images, which is what happened once.
/public/review-generated/
