# The enquiry form's endpoint: the /exec URL of the Google Apps Script Web App
# that appends to the enquiries Sheet. See docs/enquiries-apps-script.gs for the
# script and the deployment steps.
#
# Set this in Netlify (Site configuration -> Environment variables) as well —
# this file is only a record of what the build expects, it is not read.
#
# Until it is set the contact form shows the email address instead of a submit
# path, rather than offering a button that cannot work.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Google Analytics 4 measurement id, shaped G-XXXXXXXXXX. Public by design —
# it names a property to write into and grants nothing.
#
# Set this in Netlify (Site configuration -> Environment variables) as well —
# this file is only a record of what the build expects, it is not read.
#
# Left unset, no tag is rendered at all. That is deliberate: it keeps local
# development and every deploy preview out of the production numbers.
NEXT_PUBLIC_GA_ID=

# Comma-separated work emails allowed to sign in and publish blogs. Keep the
# real list out of Git: put it in .env.local and in Netlify. Server-only, so
# never prefix it with NEXT_PUBLIC_. Left unset, nobody can sign in.
BLOG_TEAM_EMAILS=

# Netlify Blobs store for posts and images. Use a different value for each
# deploy context (for example arak-blog in Production and arak-blog-preview in
# Deploy Previews), or a preview can publish to the live blog.
BLOG_STORE=

# Microsoft sign-in, from the Entra app registration. All server-only.
# BLOG_ENTRA_TENANT_ID must be the tenant GUID. Register
# <BLOG_AUTH_ORIGIN>/team/auth/callback as a Web redirect URI.
BLOG_ENTRA_TENANT_ID=
BLOG_ENTRA_CLIENT_ID=
BLOG_ENTRA_CLIENT_SECRET=
BLOG_AUTH_ORIGIN=https://arak-sa.com

# Signs team sessions. At least 32 random characters: openssl rand -base64 48
BLOG_SESSION_SECRET=
