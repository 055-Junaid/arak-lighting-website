# Cache-Control for the static assets under public/.
#
# Netlify serves _headers from the publish directory, so this file has to live
# in public/ — Next copies it into .next at build time. Keep it here.
#
# WHAT THIS DOES AND DOES NOT COVER
# ---------------------------------
# These rules apply to the files themselves: the logo marks, the project
# photographs, the company profile. They set how long a *browser* holds its
# own copy.
#
# They do NOT apply to anything served by a function, which on Netlify
# includes SSR routes and /_next/image. Those responses carry their own
# headers. That is fine here: Netlify Image CDN caches each transform on its
# edge and reuses it for every later request for the same transformation,
# independently of what the source file's Cache-Control says. So the optimised
# images are shared between visitors whether or not this file exists.
#
# (This file was originally written for Cloudflare Workers, where it was doing
# something quite different and much more load-bearing: the OpenNext Cloudflare
# image handler only marked its output cacheable when the source already said
# `immutable`, and workers.dev bypasses the CDN cache entirely, so without
# these rules every optimised image was rebuilt per request. None of that
# mechanism applies on Netlify — do not reason from it.)
#
# TRADE-OFF — read before replacing an image: `immutable` means a browser may
# keep its copy effectively forever. Overwriting a file in place will NOT reach
# anyone who already has it. To change a picture, give the new file a new name
# and update the reference; do not overwrite the old path. Re-compressing an
# image is not a content change and is safe to do in place, since the old and
# new files show the same picture.

/projects/*
  Cache-Control: public, max-age=31536000, immutable

/home/*
  Cache-Control: public, max-age=31536000, immutable

/smart-poles/*
  Cache-Control: public, max-age=31536000, immutable

/services/*
  Cache-Control: public, max-age=31536000, immutable

/generated/*
  Cache-Control: public, max-age=31536000, immutable

/brands/*
  Cache-Control: public, max-age=31536000, immutable

/clients/*
  Cache-Control: public, max-age=31536000, immutable

/vendors/*
  Cache-Control: public, max-age=31536000, immutable

/arak-logo-black.png
  Cache-Control: public, max-age=31536000, immutable

/arak-logo-white.png
  Cache-Control: public, max-age=31536000, immutable

# Build output is content-hashed, so the filename changes whenever the bytes
# do and the caveat above cannot bite.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The company profile is replaced in place each year and is linked from the
# site, so it stays revalidated rather than immutable.
/docs/*
  Cache-Control: public, max-age=3600, must-revalidate
